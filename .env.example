# Project settings
PROJECT_NAME=wp
UID=1000
GID=1000

# Traefik hostnames (.localhost — Chrome blocks HTTPS on .local)
# Site: https://wp.localhost | phpMyAdmin: https://pma.wp.localhost
SITE_HOSTNAME=wp.localhost
PMA_HOSTNAME=pma.wp.localhost

# Database
DB_HOST=db
DB_NAME=wp
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
MYSQL_VERSION=8


# WordPress
WP_ADMIN_USER=user
WP_ADMIN_PASSWORD=password
WP_ADMIN_EMAIL=email@example.com

# WordPress debug (true — debug.log and on-screen errors)
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=true
