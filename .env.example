# Project settings
PROJECT_NAME=wpl
UID=1000
GID=1000

# Traefik hostnames (.localhost — Chrome blocks HTTPS on .local)
# Site: https://wpl.localhost/wp-admin | phpMyAdmin: https://pma.wpl.localhost
SITE_HOSTNAME=wpl.localhost
PMA_HOSTNAME=pma.wpl.localhost

# Database
DB_HOST=db
DB_NAME=wp
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
MYSQL_VERSION=8


# WordPress
WP_ADMIN_USER=Username
WP_ADMIN_PASSWORD=Password
WP_ADMIN_EMAIL=email@example.com

# Locale packs for make wp-update-translations and first install (comma-separated).
# First locale is activated on first install. Empty = English only. en_US is built-in.
# Example: WP_LANGUAGE=ru_RU,de_DE
WP_LANGUAGE=ru_RU

# WordPress debug (true — debug.log and on-screen errors)
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=true
